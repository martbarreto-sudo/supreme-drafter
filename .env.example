# Chave da API Anthropic (obrigatória)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo (opcional; padrão: claude-opus-4-8)
DEEP_HUNTER_MODEL=claude-opus-4-8

# Nível de esforço: low | medium | high | xhigh | max (opcional; padrão: high)
DEEP_HUNTER_EFFORT=high

# Canal do modelo: anthropic (padrão) | vertex
DEEP_HUNTER_PROVEDOR=anthropic

# Apenas na rota vertex — lidos pelo SDK; credenciais por ADC (gcloud auth
# application-default login). Mantenha a região no perímetro exigido pelo cliente.
# ANTHROPIC_VERTEX_PROJECT_ID=meu-projecto-gcp
# CLOUD_ML_REGION=us-east5
